# ═══════════════════════════════════════════════════════════
# ARC TESTNET (Circle's L1, USDC native)
# ═══════════════════════════════════════════════════════════
# Arc Testnet RPC (fallback otomatis ke public RPC kalau kosong)
RPC_URL=https://rpc.drpc.testnet.arc.network
CHAIN_ID=5042002
EXPLORER=https://testnet.arcscan.app

# ═══════════════════════════════════════════════════════════
# LITVM TESTNET (Litecoin L2, zkLTC native)
# ═══════════════════════════════════════════════════════════
LITVM_RPC_URL=https://liteforge.rpc.caldera.xyz/http
LITVM_WS_URL=wss://liteforge.rpc.caldera.xyz/ws
LITVM_CHAIN_ID=4441
LITVM_EXPLORER=https://liteforge.explorer.caldera.xyz

# LitVM task amounts (zkLTC)
LITVM_SELF_TX_AMOUNT=0.0001
LITVM_WRAP_AMOUNT=0.001
LITVM_UNWRAP_AMOUNT=0.0005
LITVM_SWAP_AMOUNT=0.0005
# Slippage tolerance for swap & LP (basis points). 500 = 5%
LITVM_SLIPPAGE_BPS=500
# Min native zkLTC balance to farm (skip wallet kalau di bawah ini)
LITVM_MIN_ZKLTC_FARM=0.01
# Batch parallel size LitVM (override BATCH_SIZE global)
LITVM_BATCH_SIZE=2
# Optional: include Lester Labs token deploy (fee 0.05 zkLTC per cycle, mahal!)
LITVM_INCLUDE_LESTER=false

# Daftar private key, pisahkan dengan koma (TANPA 0x juga boleh)
# Contoh: PRIVATE_KEYS=0xabc...,0xdef...
PRIVATE_KEYS=

# Atau simpan di file wallets.txt (satu PK per baris). Kalau diisi, override PRIVATE_KEYS.
WALLETS_FILE=wallets.txt

# Jumlah transaksi per wallet per run
TX_PER_WALLET=1

# Delay antar tx per wallet (ms) - range acak [min,max]
# Semakin kecil = lebih cepat, tapi resiko rate-limit RPC naik
DELAY_MIN_MS=100
DELAY_MAX_MS=500

# Delay antar wallet (ms)
WALLET_DELAY_MIN_MS=1500
WALLET_DELAY_MAX_MS=5000

# Jalankan wallet secara paralel? (true/false). false = sequential, aman untuk nonce
PARALLEL_WALLETS=false

# Task yang diaktifkan legacy runner (comma separated)
ENABLED_TASKS=randomTransferUsdc,randomTransferEurc,approveUsdcFx,approveEurcFx,deployErc20,deployNft

# Jumlah transfer token Arc (dalam unit token, bukan wei). Desimal OK.
SELF_TX_AMOUNT_USDC=0.1
SELF_TX_AMOUNT_EURC=0.1

# Loop mode: jalankan terus-menerus dengan jeda antar siklus
LOOP=false
LOOP_DELAY_MIN_MS=300000
LOOP_DELAY_MAX_MS=900000

# === CCTP BRIDGE (Sepolia -> Arc) ===
# RPC Sepolia untuk bridging (public default oke)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Jumlah USDC yang di-bridge per wallet
BRIDGE_AMOUNT_USDC=1
# Alamat tujuan di Arc (kosongkan = bridge ke address yang sama / self)
BRIDGE_DEST_ADDRESS=
# Interval polling attestation Circle IRIS (ms). Default 2000 (cepat)
BRIDGE_POLL_MS=2000

# === zkCodex tasks ===
# Jumlah kali call Counter per cycle per wallet (default 3, bisa dinaikkan)
COUNTER_PER_CYCLE=1

# === DAILY FARMING (multi-wallet batch parallel) ===
# Jumlah wallet yang jalan BARENG dalam 1 batch.
#   3  = aman buat RPC publik (drpc/public node)
#   5  = OK buat RPC bagus
#   10 = butuh RPC premium (Alchemy/QuickNode)
BATCH_SIZE=2

# Arc fail-fast default: 0 = kalau task fail/timeout langsung lanjut task berikutnya.
# Naikkan ke 1-3 kalau mau retry Arc task yang transient.
ARC_TASK_RETRIES=0

# Deadline per wallet (ms). Kalau 1 wallet jalan lebih dari ini (kemungkinan stuck nonce
# atau RPC issue spesifik), sisa task di-skip dan slot pool dilepas. Default 600000 (10 min).
WALLET_DEADLINE_MS=600000

# Timeout per attempt task (ms). Kalau 1 task hang lebih dari ini, auto-abort + retry.
# Default 300000 (5 menit) — cukup untuk task multi-tx (mis. zkCounter×3 @90s each).
TASK_TIMEOUT_MS=180000

# Timeout tunggu confirmation 1 tx (ms). Default 90000 (90 detik).
TX_TIMEOUT_MS=90000

# Skip wallet kalau saldo USDC < ini (dalam unit USDC, default 0.05).
# Tasknya butuh ~0.4 USDC total, jadi 0.5 saran lebih aman.
MIN_USDC_FARM=0.05
